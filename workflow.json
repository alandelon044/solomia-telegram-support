    {
      "parameters": {
        "chatId": "YOUR_ADMIN_CHAT_ID",
        "text": "={{ ['New ticket #' + $json.ticket_id, 'Category: ' + $json.category, 'Priority: ' + $json.priority, '', 'Customer message:', $json.original_text, '', 'Summary:', $json.summary, '', 'Draft for review:', $json.draft].join(String.fromCharCode(10)).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Send to customer",
                    "additionalFields": {
                      "callback_data": "={{ 'send_' + $json.ticket_id }}"
                    }
                  },
                  {
                    "text": "👤 Take over",
                    "additionalFields": {
                      "callback_data": "={{ 'human_' + $json.ticket_id }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
